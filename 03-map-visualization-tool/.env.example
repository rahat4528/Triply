# Database Configuration (PostGIS Enabled)
POSTGRES_DB=triply_map_viz_db
POSTGRES_USER=triply_user
POSTGRES_PASSWORD=triply_secret_password
POSTGRES_PORT=5434
DATABASE_URL=postgresql://triply_user:triply_secret_password@localhost:5434/triply_map_viz_db?schema=public

# S3-Compatible Storage (MinIO Local)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=triply-spatial-datasets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret

# Server & Ingestion Configuration
PORT=4003
NODE_ENV=development
JWT_SECRET=super-secret-triply-map-viz-key-2026
MAX_UPLOAD_SIZE_MB=50
MAX_FEATURE_COUNT=100000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4003/api/v1
NEXT_PUBLIC_DEFAULT_LAT=51.5074
NEXT_PUBLIC_DEFAULT_LON=-0.1278
NEXT_PUBLIC_DEFAULT_ZOOM=11
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
