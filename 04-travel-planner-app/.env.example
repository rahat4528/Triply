# Travel Planner Application Environment Configuration

NODE_ENV=development
PORT=4003

# Database (PostgreSQL)
DATABASE_URL=postgresql://triply_user:triply_secure_password_2026@localhost:5435/triply_travel_planner_db

# Redis
REDIS_URL=redis://localhost:6382

# S3 Document Storage (MinIO)
S3_ENDPOINT=localhost
S3_PORT=9005
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_password_2026
S3_BUCKET=triply-travel-documents
S3_USE_SSL=false

# Exchange Rate Provider Configuration
EXCHANGE_RATE_API_URL=https://api.frankfurter.app
USE_FIXTURE_EXCHANGE_RATES=true

# Calendar Feed Secret
CALENDAR_FEED_SECRET=triply_travel_calendar_token_secret_key_2026

# Frontend Client URL
CLIENT_URL=http://localhost:3003
