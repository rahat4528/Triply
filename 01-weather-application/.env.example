# Database Configuration
POSTGRES_DB=triply_weather_db
POSTGRES_USER=triply_user
POSTGRES_PASSWORD=triply_secret_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://triply_user:triply_secret_password@localhost:5432/triply_weather_db?schema=public

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Server Configuration
PORT=4001
NODE_ENV=development
JWT_SECRET=super-secret-triply-weather-key-change-in-production

# External Provider Configuration
# Open-Meteo free tier requires attribution; commercial license requires an API key
WEATHER_PROVIDER=open-meteo
OPEN_METEO_API_KEY=
WEATHER_API_BUDGET_DAILY=10000
WEATHER_CACHE_TTL_SECONDS=900

# Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1
NEXT_PUBLIC_DEFAULT_LAT=51.5074
NEXT_PUBLIC_DEFAULT_LON=-0.1278
