# Database Configuration (PostGIS Enabled)
POSTGRES_DB=triply_location_db
POSTGRES_USER=triply_user
POSTGRES_PASSWORD=triply_secret_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://triply_user:triply_secret_password@localhost:5433/triply_location_db?schema=public

# Redis Configuration
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Backend Configuration
PORT=4002
NODE_ENV=development
JWT_SECRET=super-secret-triply-location-token-change-in-production

# Geospatial & Privacy Defaults
DEFAULT_SEARCH_RADIUS_METERS=5000
MAX_SEARCH_RADIUS_METERS=50000
LOCATION_HISTORY_RETENTION_DAYS=30
MIN_ACCURACY_THRESHOLD_PERCENT=50

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4002/api/v1
NEXT_PUBLIC_DEFAULT_LAT=51.5074
NEXT_PUBLIC_DEFAULT_LON=-0.1278
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
