{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "*": ["*", "node_modules/*"]
    }
  },
  "include": [
    "src/**/*",
    "../optimization-engine/**/*",
    "../database/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../tests",
    "**/*.spec.ts"
  ]
}
