# Delivery Route Optimizer Environment Configuration

NODE_ENV=development
PORT=4004

# Database (PostgreSQL)
DATABASE_URL=postgresql://triply_user:triply_secure_password_2026@localhost:5436/triply_route_optimizer_db

# Redis
REDIS_URL=redis://localhost:6383

# VROOM Solver Service
VROOM_URL=http://localhost:3000
USE_FIXTURE_VROOM=true

# OSRM Routing Service
OSRM_URL=http://localhost:5000
USE_HAVERSINE_MATRIX_FALLBACK=true

# Frontend Client URL
CLIENT_URL=http://localhost:3004
